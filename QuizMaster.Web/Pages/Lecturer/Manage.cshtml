@page "{quizId:int}"
@model QuizMaster.Web.Pages.Lecturer.ManageModel
@{
	ViewData["Title"] = Model.Quiz?.Title ?? "Manage quiz";
	var quiz = Model.Quiz;
	const string closeFirst = "This quiz is published. Close it before making changes.";
}

@if (quiz == null)
{
	<p><a asp-page="/Lecturer/Quizzes">Back to my quizzes</a></p>
}
else
{
	var editable = !quiz.IsPublished;

	<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
		<div>
			<h1 class="h3 mb-1">
				@quiz.Title
				<span class="badge align-middle fs-6 @(quiz.IsPublished ? "bg-success" : "bg-secondary")">@DisplayFormat.FormatQuizStatus(quiz.IsPublished)</span>
			</h1>
			<div class="text-muted">
				Topic: @quiz.Topic · @quiz.QuestionCount questions · max score @quiz.MaxScore · @quiz.TimeLimitMinutes min · pass @quiz.PassPercent%
			</div>
		</div>
		<a asp-page="/Lecturer/Quizzes">Back to my quizzes</a>
	</div>

	if (!editable)
	{
		<div class="alert alert-info">@closeFirst</div>
	}

	<div class="d-flex flex-wrap gap-2 mb-4">
		@if (editable)
		{
			<a class="btn btn-outline-primary" asp-page="/Lecturer/EditQuiz" asp-route-quizId="@quiz.Id">Edit details</a>
			<a class="btn btn-outline-primary" asp-page="/Lecturer/Question" asp-route-quizId="@quiz.Id">Add question</a>
			<form method="post" asp-page-handler="Publish" asp-route-quizId="@quiz.Id">
				<button type="submit" class="btn btn-success">Publish</button>
			</form>
		}
		else
		{
			<button type="button" class="btn btn-outline-primary" disabled title="@closeFirst">Edit details</button>
			<button type="button" class="btn btn-outline-primary" disabled title="@closeFirst">Add question</button>
			<form method="post" asp-page-handler="Close" asp-route-quizId="@quiz.Id"
				  data-confirm="Close this quiz? Students can't start it until you publish it again.">
				<button type="submit" class="btn btn-warning">Close</button>
			</form>
		}
		<form method="post" asp-page-handler="Delete" asp-route-quizId="@quiz.Id"
			  data-confirm="@($"Delete \"{quiz.Title}\" permanently?")">
			<button type="submit" class="btn btn-outline-danger">Delete quiz</button>
		</form>
	</div>

	<h2 class="h4">Questions</h2>
	if (quiz.Questions.Count == 0)
	{
		<p>No questions yet.</p>
	}
	for (var i = 0; i < quiz.Questions.Count; i++)
	{
		var question = quiz.Questions[i];
		<div class="card mb-2">
			<div class="card-body">
				<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
					<div>
						<strong>#@(i + 1)</strong> · @DisplayFormat.FormatType(question.Type) · @DisplayFormat.FormatPoints(question.Points)
					</div>
					<div class="d-flex gap-2">
						@if (editable)
						{
							<a class="btn btn-sm btn-outline-primary" asp-page="/Lecturer/Question" asp-route-quizId="@quiz.Id" asp-route-questionId="@question.Id">Edit</a>
							<form method="post" asp-page-handler="RemoveQuestion" asp-route-quizId="@quiz.Id" asp-route-questionId="@question.Id"
								  data-confirm="@($"Remove \"{DisplayFormat.Truncate(question.Text, 50)}\"?")">
								<button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
							</form>
						}
						else
						{
							<button type="button" class="btn btn-sm btn-outline-primary" disabled title="@closeFirst">Edit</button>
							<button type="button" class="btn btn-sm btn-outline-danger" disabled title="@closeFirst">Remove</button>
						}
					</div>
				</div>
				<p class="mt-2 mb-1 preserve-lines">@question.Text</p>
				<ol class="mb-0">
					@foreach (var option in question.Options.OrderBy(o => o.Position))
					{
						<li>@option.Text</li>
					}
				</ol>
			</div>
		</div>
	}
	<p class="text-muted small mt-3">Correct answers are private to each question, so they aren't shown.</p>
}
