@page
@model QuizMaster.Web.Pages.Lecturer.LogsModel
@{
	ViewData["Title"] = "Recent log entries";
}

<h1 class="h3">Recent log entries</h1>
<p class="text-muted">The @QuizMaster.Web.Pages.Lecturer.LogsModel.EntryCount most recent entries, newest first.</p>

@if (Model.Entries.Count == 0)
{
	<p>The log is empty.</p>
}
else
{
	<div class="table-responsive">
		<table class="table table-sm table-striped align-middle">
			<thead>
				<tr>
					<th class="text-nowrap">Time</th>
					<th>Event</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var entry in Model.Entries)
				{
					<tr class="@(entry.EventType == LogEventType.Error ? "table-danger" : null)">
						<td class="text-nowrap">@DisplayFormat.FormatTimestamp(entry.Timestamp)</td>
						<td>@entry.EventType</td>
						<td class="text-break">@entry.Message</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
