@page
@model QuizMaster.Web.Pages.Account.LoginModel
@{
	ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
	<div class="col-md-7 col-lg-5">
		<h1 class="h3 mb-3">Log in</h1>
		<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
			<div class="mb-3">
				<label asp-for="Input.Username" class="form-label">Username</label>
				<input asp-for="Input.Username" class="form-control" autocomplete="username" required maxlength="@InputLimits.UsernameMax" autofocus />
			</div>
			<div class="mb-3">
				<label asp-for="Input.Password" class="form-label">Password</label>
				<input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" required />
			</div>
			<button type="submit" class="btn btn-primary">Log in</button>
		</form>
		<p class="mt-3">No account yet? <a asp-page="/Account/Register">Register</a></p>
	</div>
</div>
