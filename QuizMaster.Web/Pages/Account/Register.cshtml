@page
@model QuizMaster.Web.Pages.Account.RegisterModel
@{
	ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
	<div class="col-md-7 col-lg-5">
		<h1 class="h3 mb-3">Register</h1>
		<form method="post">
			<div class="mb-3">
				<label asp-for="Input.Username" class="form-label">Username</label>
				<input asp-for="Input.Username" class="form-control" autocomplete="username" required
					   minlength="@InputLimits.UsernameMin" maxlength="@InputLimits.UsernameMax" autofocus />
				<div class="form-text">@InputLimits.UsernameMin-@InputLimits.UsernameMax characters: letters, digits, '_' and '.'.</div>
			</div>
			<div class="mb-3">
				<label asp-for="Input.Email" class="form-label">Email</label>
				<input asp-for="Input.Email" type="text" class="form-control" autocomplete="email" required maxlength="@InputLimits.EmailMax" />
			</div>
			<div class="mb-3">
				<label asp-for="Input.Password" class="form-label">Password</label>
				<input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" required minlength="@InputLimits.PasswordMin" />
				<div class="form-text">At least @InputLimits.PasswordMin characters.</div>
			</div>
			<fieldset class="mb-3">
				<legend class="form-label fs-6">Role</legend>
				<div class="form-check form-check-inline">
					<input class="form-check-input" type="radio" id="role-student" name="Input.Role" value="@UserRole.Student" checked="@(Model.Input.Role == UserRole.Student)" />
					<label class="form-check-label" for="role-student">Student</label>
				</div>
				<div class="form-check form-check-inline">
					<input class="form-check-input" type="radio" id="role-lecturer" name="Input.Role" value="@UserRole.Lecturer" checked="@(Model.Input.Role == UserRole.Lecturer)" />
					<label class="form-check-label" for="role-lecturer">Lecturer</label>
				</div>
			</fieldset>
			<button type="submit" class="btn btn-primary">Register</button>
		</form>
		<p class="mt-3">Already registered? <a asp-page="/Account/Login">Log in</a></p>
	</div>
</div>
